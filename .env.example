# Backend
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Frontend (prefix VITE_ pour Vite) — build-time uniquement (Vite l'inline au
# build). En prod (Railway, un seul service), à LAISSER VIDE/absent : le
# frontend détecte automatiquement la même origine que le backend
# (frontend/src/services/backendUrl.ts). Utile seulement si le frontend est
# servi séparément du backend (ex: preview Vercel pointant vers un backend
# distant).
VITE_BACKEND_URL=http://localhost:3001

# Supabase — OBLIGATOIRE pour brancher GameDataStore et ETL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...           # clé publique (lecture seule en prod)
SUPABASE_SERVICE_KEY=eyJ...        # service_role key — OBLIGATOIRE pour l'ETL (push-to-supabase.ts)

# Genius API — OBLIGATOIRE pour l'ETL (etl.ts)
GENIUS_ACCESS_TOKEN=

# ============================================================
# Déploiement Railway (un seul service : API + WebSocket + frontend statique)
# ============================================================
# Variables à configurer dans Railway > Variables :
#   SUPABASE_URL           (obligatoire — le serveur ne démarre pas sans)
#   SUPABASE_SERVICE_KEY   (obligatoire — accès service_role pour toutes les écritures)
# Tout le reste (PORT, build/serve du frontend) est géré automatiquement :
#   - PORT est injecté par Railway, déjà lu via process.env.PORT
#   - le build (`npm run build`) compile le backend (tsc) ET le frontend (vite build)
#   - au démarrage, le serveur détecte frontend/dist et le sert directement —
#     aucune variable NODE_ENV/VITE_BACKEND_URL à définir pour que ça marche.
# Les clés GENIUS_ACCESS_TOKEN / LASTFM_API_KEY / PIXELLAB_API_KEY ne servent
# qu'aux scripts one-off (ETL, resync popularité, génération d'assets) —
# inutiles sur le service Railway lui-même, à lancer en local contre la prod.
